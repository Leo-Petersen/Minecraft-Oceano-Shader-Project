# Profiles #
profile.VeryLow=Very Low
profile.Low=Low
profile.Default=Default
profile.High=High


# Mods #
option.PHOTONICS_ENABLED=Photonics (Very WIP)
option.PHOTONICS_ENABLED.comment=Enable Photonics raytracing. Requires the Photonics mod. Implementation currently unfinished, very WIP, many bugs


# Light Map #
screen.LightMap=Light Map

option.shadowMap=Shadow Map
    option.shadowMap.comment=Enables/disables the shadow map, the shader is not built for having the shadow map disabled, this options exists just for customizability (huge performance gain, but many features will break)
option.shadowMapResolution=Shadow Map Resolution
option.shadowDistance=Shadow Distance
    option.shadowDistance.comment=The distance at which shadows are rendered. Lower values improve performance, but can cause shadows to pop in and out of view. 256 is a good value, highly recommended to use Distant Horizons rather than increasing the shadow distance / mc render distance.
option.sunPathRotation=Sun Path Rotation

option.torchLightMap=Emissives Lightmap
    screen.torchColors=Emissives Colors
        screen.torchColors.comment=Changes the color of the Emissives lightmap, only works when Voxel Lighting is disabled
        option.torchR=Red
        option.torchG=Green
        option.torchB=Blue
option.skyLightMap=Sky Lightmap


# Lighting #
screen.Lighting=Lighting

option.lightingQuality=Lighting Quality
    option.lightingQuality.comment=Number of samples used when filtering the lighting. Higher is cleaner but costs performance.
option.lightStr=Sunlight Strength
option.sunStrength=Sun Intensity
    option.sunStrength.comment=Raw brightness of direct sunlight before tonemapping.
option.min_skyLightMap=Minimum Sky Light
    option.min_skyLightMap.comment=Lowest sky lightmap value; raises the darkest indoor/night ambient floor.
option.filterStr=Shadow Filter Strength
    option.filterStr.comment=Strength of the lighting denoise filter. Higher removes more noise but softens detail.
option.ambientStr=Ambient Strength
option.distAmbient=Distant Ambient Strength

option.VoxelLighting=Voxel Lighting
    option.VoxelLighting.comment=Enables/disables the voxel lighting system, this provides coloured emissive lighting. LOW FPS COST

option.SubsurfaceScattering=Subsurface Scattering
option.SSS_Quality=SSS Quality

    # Ambient Occlusion #
    screen.AO=Ambient Occlusion
        option.AO=Ambient Occlusion
        option.aoRadius=Occlusion Radius
        option.aoQuality=Occlusion Quality
        option.aoStrength=Occlusion Strength

    # Fake GI Fill Light #
    screen.FillLight=Fake GI Fill Light
        option.BounceLight=Fake GI Fill Light
        option.BounceLight.comment=Adds a fill ('bounced') light to the scene to fake global illumination using psuedo values and surrounding texture colors. Can cause subtle color bleeding on shadows cast by 'saturated' blocks when colored is enabled.
        option.bounceQuality=Quality
        option.BounceLightStr=Strength

    # Pixel Shadows #
    screen.PixelShadows=Pixel Shadows
        option.PixelLockedShadows=Pixel Locked Shadows
        option.PixelLockedShadows.comment=Snaps shadows to the world pixel grid, like Bedrock shaders.
        option.shadowPixelResolution=Shadow Pixel Resolution
        option.shadowPixelResolution.comment=Grid cells per block. Match to texture pack resolution / preference.


# Atmosphere #
screen.Atmosphere=Atmosphere

option.atmosphereFog=Atmosphere Fog
option.atmosApDensity=Atmosphere Density
option.fogBlur=Fog Blur
option.BorderFog=Border Fog
    option.BorderFog.comment=Fades the far edge of the render distance into fog.
option.caveFog=Cave Fog
option.caveFogStrength=Cave Fog Strength

    # Volumetric Light #
    screen.VolumetricLight=Volumetric Light
        option.volumetricLight=Volumetric Light
        option.volumetricLight.comment=Enables raymarched god rays / light shafts.
        option.volumetricFogQuality=Quality
            option.volumetricFogQuality.comment=Raymarch step count for volumetric fog and light. Higher is smoother but costs performance.
        option.FogAltitude=Fog Altitude
            option.FogAltitude.comment=World height around which the ground fog layer settles.
        option.FogStrength=Fog Strength

    # Volumetric Clouds #
    screen.VolumetricClouds=Volumetric Clouds
        option.VolumetricClouds=Volumetric Clouds
        option.VolumetricClouds.comment=Enables raymarched volumetric clouds.
        option.cloudQuality=Cloud Quality
            value.cloudQuality.1=Low
            value.cloudQuality.2=Default
            value.cloudQuality.3=High
            value.cloudQuality.4=Ultra
            value.cloudQuality.5=Full Resolution
            option.cloudQuality.comment=Overall quality of the clouds; controls raymarch steps and internal upscale factor. Higher looks cleaner but costs performance.
        option.cloudReflections=Cloud Reflections
            option.cloudReflections.comment=Renders the volumetric clouds in reflective surfaces such as water.
        option.cloudReflSteps=Reflection Steps
            option.cloudReflSteps.comment=Raymarch steps used when clouds are drawn in reflections.

        # Shape & Coverage #
        screen.CloudShape=Shape & Coverage
            option.cloudAltitude=Altitude
            option.cloudAltitude.comment=Altitude offset for the cloud layer. Has a small performance impact.
            option.cloudScale=Noise Scale
            option.cloudScale.comment=World space scale of the base cloud noise. Smaller values make larger cloud formations.
            option.cloudSize=Size
            option.cloudSize.comment=Overall scale of the clouds.
            option.cloudThickness=Thickness
            option.cloudThickness.comment=Vertical thickness of the cloud layer.
            option.cloudCoverage=Coverage
            option.cloudCoverage.comment=How much of the sky the clouds fill.
            option.cloudSeparation=Separation
            option.cloudSeparation.comment=Spacing between individual cloud formations.
            option.cloudDensity=Density
            option.cloudDensity.comment=Overall opacity of the clouds.
            option.cloudTopFall=Top Falloff
            option.cloudTopFall.comment=Softness of the cloud tops.
            option.cloudBaseFlat=Base Flatten
            option.cloudBaseFlat.comment=Flattens the underside of the clouds.

        # Masses & Height #
        screen.CloudMasses=Masses & Height
            option.cloudBigClouds=Big Cloud Masses
            option.cloudBigClouds.comment=Higher values produce more and bigger cloud masses.
            option.cloudBigMerge=Mass Merge
            option.cloudBigMerge.comment=How strongly a big cloud zone fills itself in (coverage threshold drop).
            option.cloudWarp=Domain Warp
            option.cloudWarp.comment=Swirl applied to the cloud field to break up stringy, repetitive shapes.
            option.cloudPuff=Puffiness
            option.cloudPuff.comment=Depth of the gaps carved between neighbouring clouds.
            option.cloudHeightVar=Height Variation
            option.cloudHeightVar.comment=How far individual cloud tops vary in height.
            option.cloudHeightFreq=Height Zone Size
            option.cloudHeightFreq.comment=Size of the tall/short zones. Higher is smaller, i.e. more mixed heights.
            option.cloudHeightBias=Height Bias
            option.cloudHeightBias.comment=Noise midpoint for height. Lower makes more clouds tall.

        # Detail & Noise #
        screen.CloudDetail=Detail & Noise
            option.cloudDetail=Detail Carve Depth
            option.cloudDetail.comment=Depth of the billow detail carved into the cloud shape.
            option.cloudDetailCell=Detail Cell Size
            option.cloudDetailCell.comment=Scale of the fine detail noise.
            option.cloudDetailVaspect=Detail Vertical Aspect
            option.cloudDetailVaspect.comment=Vertical stretch of the detail noise.
            option.cloudSwirl=Billow Swirl
            option.cloudSwirl.comment=Amount of swirl applied to the billow detail.

        # Lighting & Scattering #
        screen.CloudLighting=Lighting & Scattering
            option.cloudSunBrightness=Sun Brightness
            option.cloudSunBrightness.comment=Brightness of direct sunlight on the clouds.
            option.cloudAmbient=Ambient Light
            option.cloudAmbient.comment=Ambient sky light contribution on the clouds.
            option.cloudTransitionDim=Twilight Dimming
            option.cloudTransitionDim.comment=Dims the clouds during sunrise and sunset transitions.
            option.cloudMs=Multiple Scattering
            option.cloudMs.comment=Multiple scattering fill light inside the clouds.
            option.cloudPowder=Powder Effect
            option.cloudPowder.comment=Strength of the powder / dark edge effect.

        # Weather & Motion #
        screen.CloudWeather=Weather & Motion
            option.cloudWindSpeed=Wind Speed
            option.cloudWindSpeed.comment=Speed the clouds drift across the sky.
            option.cloudEvolve=Evolution Speed
            option.cloudEvolve.comment=How quickly cloud shapes change over time.


